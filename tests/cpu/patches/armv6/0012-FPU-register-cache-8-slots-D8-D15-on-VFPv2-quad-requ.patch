From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: 3ds-d2 <3ds-d2@localhost>
Date: Fri, 16 Oct 2026 21:12:04 +0300
Subject: [PATCH] FPU register cache: 8 slots (D8-D15) on VFPv2; quad requests
 abort

VFPv2 has 16 double registers. The 8 x87 registers fit D8-D15 exactly,
which the AAPCS also preserves across calls, so the push/pop of D16-D31
around C calls never emits anything. Exhaustion or a quad request (SSE)
is a loud translation-time failure instead of an out-of-range register.
---
 .../dynarec/dynarec_arm_functions.c              | 16 ++++++++++++++--
 1 file changed, 14 insertions(+), 2 deletions(-)

diff --git a/third_party/box86-dynarec/dynarec/dynarec_arm_functions.c b/third_party/box86-dynarec/dynarec/dynarec_arm_functions.c
index 0da826f..2cb40b3 100755
--- a/third_party/box86-dynarec/dynarec/dynarec_arm_functions.c
+++ b/third_party/box86-dynarec/dynarec/dynarec_arm_functions.c
@@ -439,8 +439,15 @@ int fpu_get_reg_double(dynarec_arm_t* dyn, unsigned int t, unsigned int n)
 {
     // TODO: check upper limit?
     int i=0;
-    while (dyn->n.fpuused[i] && (i<24)) ++i;
-    assert(i<24);
+    // VFPv2 (ARMv6) has D0-D15 only: the cache is D8-D15, exactly the 8 x87
+    // registers (MMX/SSE are never cached: CPUID hides them on that target).
+    #if __ARM_ARCH >= 7
+    const int slots = 24;
+    #else
+    const int slots = 8;
+    #endif
+    while (i<slots && dyn->n.fpuused[i]) ++i;
+    if(i>=slots) { dynarec_log(LOG_NONE, "FPU register cache exhausted (%d slots)\n", slots); abort(); }
 
     dyn->n.fpuused[i] = 1;
     dyn->n.neoncache[i].n = n;
@@ -460,6 +467,11 @@ void fpu_free_reg_double(dynarec_arm_t* dyn, int reg)
 // Get a FPU quad reg
 int fpu_get_reg_quad(dynarec_arm_t* dyn, unsigned int t, unsigned int n)
 {
+    #if __ARM_ARCH < 7
+    // Quads only back XMM registers; VFPv2 has none and CPUID hides SSE.
+    dynarec_log(LOG_NONE, "FPU quad register requested on VFPv2 (SSE path reached)\n");
+    abort();
+    #endif
     int i=0;
     while ((dyn->n.fpuused[i] || dyn->n.fpuused[i+1]) && (i<24)) i+=2;
     assert(i<24);
