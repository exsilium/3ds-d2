From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: 3ds-d2 <3ds-d2@localhost>
Date: Sat, 17 Oct 2026 00:42:02 +0300
Subject: [PATCH] cpuid: leaf-1 EDX feature bits settable at run time
 (wx86_set_cpuid1_edx)

---
 src/dynarec86/shim/my_cpuid.h  | 2 ++
 src/dynarec86/shim/shim_impl.c | 7 ++++++-
 2 files changed, 8 insertions(+), 1 deletion(-)

diff --git a/src/dynarec86/shim/my_cpuid.h b/src/dynarec86/shim/my_cpuid.h
index 25e2cd0..86dc606 100644
--- a/src/dynarec86/shim/my_cpuid.h
+++ b/src/dynarec86/shim/my_cpuid.h
@@ -8,4 +8,6 @@ void my_cpuid(x86emu_t* emu, uint32_t tmp32u);
    describing the processor (IsProcessorFeaturePresent) derive their answers
    from these instead of inventing new ones. */
 void wx86_cpuid_features(uint32_t* edx, uint32_t* ecx);
+/* Sets the leaf-1 EDX feature bits (call before the guest runs). */
+void wx86_set_cpuid1_edx(uint32_t edx);
 #endif
diff --git a/src/dynarec86/shim/shim_impl.c b/src/dynarec86/shim/shim_impl.c
index 4432374..9992c0b 100644
--- a/src/dynarec86/shim/shim_impl.c
+++ b/src/dynarec86/shim/shim_impl.c
@@ -96,7 +96,12 @@ int isRetX87Wrapper(wrapper_t fun) { (void)fun; return 0; }
    choosing its own -- two views of the same CPU that disagree (cpuid
    reporting SSE2, the API saying no) are exactly the kind of inconsistency
    that gives an emulator away. */
-#define WX86_CPUID1_EDX ((1<<0)|(1<<15)|(1<<23)|(1<<24)|(1<<25)|(1<<26)) /* FPU CMOV MMX FXSR SSE SSE2 */
+/* The EDX set is a run-time setting (wx86_set_cpuid1_edx, before the guest
+   runs): a host without SIMD (the 3DS's VFPv2) reports FPU|CMOV only, so the
+   guest picks its x87/integer paths instead of SSE code it would emulate. */
+static uint32_t wx86_cpuid1_edx_bits = (1<<0)|(1<<15)|(1<<23)|(1<<24)|(1<<25)|(1<<26); /* FPU CMOV MMX FXSR SSE SSE2 */
+void wx86_set_cpuid1_edx(uint32_t edx) { wx86_cpuid1_edx_bits = edx; }
+#define WX86_CPUID1_EDX (wx86_cpuid1_edx_bits)
 #define WX86_CPUID1_ECX (0)                                             /* no SSE3+ */
 void wx86_cpuid_features(uint32_t* edx, uint32_t* ecx)
 {
