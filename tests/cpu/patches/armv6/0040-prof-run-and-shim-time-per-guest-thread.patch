From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: 3ds-d2 <3ds-d2@localhost>
Date: Sun, 18 Oct 2026 19:00:10 +0300
Subject: [PATCH] prof: run and shim time per guest thread

EIP samples are taken only when a slice is preempted, so a thread that
always yields before the quantum expires (D2's sound update loop and a
worker thread) never shows up in them, however much it runs. Each slice
now adds its cpu->run() time, the shim-body part of it (prof::trap_ns
delta) and a slice count to its thread: prof::thread_times(). Cleared by
reset_samples() with the rest of the window.
---
 src/runtime/prof.cpp              | 12 +++++++++++-
 src/runtime/prof.h                | 12 ++++++++++--
 src/runtime/sched_cooperative.cpp |  4 +++-
 3 files changed, 24 insertions(+), 4 deletions(-)

diff --git a/src/runtime/prof.cpp b/src/runtime/prof.cpp
index ff1d336..15451a3 100644
--- a/src/runtime/prof.cpp
+++ b/src/runtime/prof.cpp
@@ -56,18 +56,28 @@ void top_eips(int n, void (*cb)(uint32_t, uint64_t, void*), void* u) {
 
 // ---- per guest thread ------------------------------------------------------
 struct TidProf { uint32_t entry = 0; uint64_t samples = 0, blocks = 0;
+                 uint64_t run_ns = 0, trap_ns = 0, slices = 0;
                  std::unordered_map<uint32_t, uint64_t> hist; };
 static std::map<uint32_t, TidProf> g_tid;
 
 void sample_eip_tid(uint32_t eip, uint32_t tid) { TidProf& t = g_tid[tid]; ++t.hist[eip]; ++t.samples; }
 void add_blocks_tid(uint32_t tid, uint32_t blocks) { g_tid[tid].blocks += blocks; }
+void add_slice_tid(uint32_t tid, uint64_t run, uint64_t trap) {
+    TidProf& t = g_tid[tid]; t.run_ns += run; t.trap_ns += trap; ++t.slices;
+}
+void thread_times(void (*cb)(uint32_t, uint64_t, uint64_t, uint64_t, void*), void* u) {
+    for (auto& p : g_tid) cb(p.first, p.second.run_ns, p.second.trap_ns, p.second.slices, u);
+}
 void note_thread(uint32_t tid, uint32_t entry) { TidProf& t = g_tid[tid]; if (!t.entry) t.entry = entry; }
 void threads(void (*cb)(uint32_t, uint32_t, uint64_t, uint64_t, void*), void* u) {
     for (auto& p : g_tid) cb(p.first, p.second.entry, p.second.samples, p.second.blocks, u);
 }
 void reset_samples() {
     g_hist.clear(); g_samples = 0;
-    for (auto& p : g_tid) { p.second.hist.clear(); p.second.samples = 0; p.second.blocks = 0; }
+    for (auto& p : g_tid) {
+        p.second.hist.clear(); p.second.samples = 0; p.second.blocks = 0;
+        p.second.run_ns = 0; p.second.trap_ns = 0; p.second.slices = 0;
+    }
 }
 void top_eips_tid(uint32_t tid, int n, void (*cb)(uint32_t, uint64_t, void*), void* u) {
     auto it = g_tid.find(tid); if (it == g_tid.end()) return;
diff --git a/src/runtime/prof.h b/src/runtime/prof.h
index 3e1e6cf..dd06e64 100644
--- a/src/runtime/prof.h
+++ b/src/runtime/prof.h
@@ -45,8 +45,14 @@ void   note_thread(uint32_t tid, uint32_t entry);
 void   threads(void (*cb)(uint32_t tid, uint32_t entry, uint64_t samples, uint64_t blocks, void* u), void* u);
 // cb(eip, hits): the n most frequent exact EIPs for the thread (n<0: all).
 void   top_eips_tid(uint32_t tid, int n, void (*cb)(uint32_t eip, uint64_t hits, void* u), void* u);
-// Clears the EIP histograms and per-thread samples/blocks (thread entries
-// stay): windowed profiles, one per reporting interval.
+// PER GUEST THREAD TIME: every slice adds its cpu->run() time and the part
+// of it spent in shim bodies. Unlike the samples, this sees threads that
+// always yield before the quantum expires.
+void   add_slice_tid(uint32_t tid, uint64_t run_ns, uint64_t trap_ns);
+// cb(tid, run_ns, trap_ns, slices) for each thread seen, in increasing tid order.
+void   thread_times(void (*cb)(uint32_t tid, uint64_t run_ns, uint64_t trap_ns, uint64_t slices, void* u), void* u);
+// Clears the EIP histograms and per-thread samples, blocks and times
+// (thread entries stay): windowed profiles, one per reporting interval.
 void   reset_samples();
 
 #else
@@ -59,6 +65,8 @@ inline void add_blocks_tid(uint32_t, uint32_t) {}
 inline void note_thread(uint32_t, uint32_t) {}
 inline void threads(void (*)(uint32_t, uint32_t, uint64_t, uint64_t, void*), void*) {}
 inline void top_eips_tid(uint32_t, int, void (*)(uint32_t, uint64_t, void*), void*) {}
+inline void add_slice_tid(uint32_t, uint64_t, uint64_t) {}
+inline void thread_times(void (*)(uint32_t, uint64_t, uint64_t, uint64_t, void*), void*) {}
 inline void reset_samples() {}
 #endif
 
diff --git a/src/runtime/sched_cooperative.cpp b/src/runtime/sched_cooperative.cpp
index dec267b..2c7fff0 100644
--- a/src/runtime/sched_cooperative.cpp
+++ b/src/runtime/sched_cooperative.cpp
@@ -284,6 +284,7 @@ void CooperativeScheduler::run_slice(GuestThread* t) {
     const char* fault = nullptr;
 #ifdef PROF_COUNTERS
     uint64_t prof_t0 = prof::now_ns();
+    const uint64_t prof_trap0 = prof::trap_ns;
     uint32_t prof_b0 = 0; cpu_->thread_emu_blocks(nullptr, &prof_b0);   // blocks per thread (exact)
 #endif
     // D2_JITPROFILE guest-run timer. Deliberately here — ONE pair of clock
@@ -295,7 +296,8 @@ void CooperativeScheduler::run_slice(GuestThread* t) {
     bool ok = cpu_->run(cpu_->reg(R_EIP), &fault);
     if (dyn86_jitprof) dyn86_jp_run_us += dyn86_jp_now_us() - jp_t0;
 #ifdef PROF_COUNTERS
-    { uint64_t dt = prof::now_ns() - prof_t0; prof::run_ns += dt; t->prof_ns += dt; }
+    { uint64_t dt = prof::now_ns() - prof_t0; prof::run_ns += dt; t->prof_ns += dt;
+      prof::add_slice_tid(t->id, dt, prof::trap_ns - prof_trap0); }
 #endif
     cpu_->save_context(t->ctx);
     if (cpu_->take_limit_hit()) preempted_ = true;        // native insn-budget expiry
