From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: 3ds-d2 <3ds-d2@localhost>
Date: Sat, 17 Oct 2026 00:21:35 +0300
Subject: [PATCH] 3DS: host clock and RDTSC from the ARM11 system tick counter

newlib's clock_gettime(CLOCK_MONOTONIC) does not provide a working clock on
the 3DS, so GetTickCount/QueryPerformanceCounter (real-time mode) and RDTSC
stood still. Linux and Vita builds are unchanged.
---
 src/dynarec86/shim/shim_impl.c | 6 ++++++
 src/runtime/host_clock.cpp     | 7 +++++++
 2 files changed, 13 insertions(+)

diff --git a/src/dynarec86/shim/shim_impl.c b/src/dynarec86/shim/shim_impl.c
index dbe23fa..4432374 100644
--- a/src/dynarec86/shim/shim_impl.c
+++ b/src/dynarec86/shim/shim_impl.c
@@ -141,6 +141,12 @@ void my_cpuid(x86emu_t* emu, uint32_t tmp32u)
 uint64_t ReadTSC(x86emu_t* emu)
 {
     (void)emu;
+#ifdef __3DS__
+    /* The ARM11 system tick counter (268 MHz) stands in for the time-stamp
+     * counter: newlib's clock_gettime is not a usable clock on the 3DS. */
+    extern uint64_t svcGetSystemTick(void);
+    return svcGetSystemTick();
+#endif
     struct timespec ts;
     clock_gettime(CLOCK_MONOTONIC, &ts);
     return (uint64_t)(ts.tv_sec) * 1000000000ULL + ts.tv_nsec;
diff --git a/src/runtime/host_clock.cpp b/src/runtime/host_clock.cpp
index 325031e..5401f7a 100644
--- a/src/runtime/host_clock.cpp
+++ b/src/runtime/host_clock.cpp
@@ -7,6 +7,8 @@
 
 #ifdef __vita__
 #include <psp2/kernel/processmgr.h>
+#elif defined(__3DS__)
+#include <3ds.h>
 #else
 #include <time.h>
 #endif
@@ -15,6 +17,11 @@ uint64_t wx86_now_us() {
 #ifdef __vita__
     // The Sony kernel already counts in microseconds.
     return (uint64_t)sceKernelGetProcessTimeWide();
+#elif defined(__3DS__)
+    // newlib's clock_gettime(CLOCK_MONOTONIC) is not a usable clock on the 3DS;
+    // the ARM11 system tick counter (SYSCLOCK_ARM11 Hz) is.
+    const uint64_t t = svcGetSystemTick();
+    return (t / SYSCLOCK_ARM11) * 1000000ull + (t % SYSCLOCK_ARM11) * 1000000ull / SYSCLOCK_ARM11;
 #else
     struct timespec ts;
     clock_gettime(CLOCK_MONOTONIC, &ts);
