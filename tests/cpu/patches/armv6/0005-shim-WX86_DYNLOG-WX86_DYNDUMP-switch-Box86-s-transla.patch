From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: 3ds-d2 <3ds-d2@localhost>
Date: Fri, 16 Oct 2026 20:56:29 +0300
Subject: [PATCH] shim: WX86_DYNLOG / WX86_DYNDUMP switch Box86's translator
 log and opcode dump

Both were frozen at 0. Unset, the cost is one cached getenv check.
---
 src/dynarec86/shim/debug.h     | 19 +++++++++++++++++--
 src/dynarec86/shim/shim_impl.c |  3 +++
 2 files changed, 20 insertions(+), 2 deletions(-)

diff --git a/src/dynarec86/shim/debug.h b/src/dynarec86/shim/debug.h
index e6347d1..693934d 100644
--- a/src/dynarec86/shim/debug.h
+++ b/src/dynarec86/shim/debug.h
@@ -24,7 +24,16 @@ typedef struct box86context_s box86context_t;
 #define printf_log(L, ...)   do { } while(0)
 #define printf_dump(L, ...)  do { } while(0)
 #define printf_dlsym(L, ...) do { } while(0)
-#define dynarec_log(L, ...)  do { } while(0)
+/* WX86_DYNLOG=<level> (0 none, 1 info, 2 debug): route Box86's translator log
+ * to stderr. Unset = compiled-in no-op cost of one cached getenv check. */
+#include <stdio.h>
+#include <stdlib.h>
+static inline int wx86_dynlog_level(void) {
+    static int lvl = -2;
+    if (lvl == -2) { const char* s = getenv("WX86_DYNLOG"); lvl = s ? atoi(s) : -1; }
+    return lvl;
+}
+#define dynarec_log(L, ...)  do { if (wx86_dynlog_level() >= (L)) fprintf(stderr, __VA_ARGS__); } while(0)
 
 #define EXPORT
 #define EXPORTDYN
@@ -62,7 +71,13 @@ static const uintptr_t box86_load_addr = 0;
 static const int box86_showbt = 0;
 static const int box86_maxcpu = 0;
 static const int box86_maxcpu_immutable = 0;
-static const int box86_dynarec_dump = 0;
+/* WX86_DYNDUMP=1: print every emitted ARM instruction (Box86's own arm_print). */
+static inline int wx86_dyndump_level(void) {
+    static int lvl = -1;
+    if (lvl == -1) { const char* s = getenv("WX86_DYNDUMP"); lvl = s ? atoi(s) : 0; }
+    return lvl;
+}
+#define box86_dynarec_dump (wx86_dyndump_level())
 static const int box86_dynarec_trace = 0;
 static const int box86_dynarec_forced = 0;
 static int box86_dynarec_largest __attribute__((unused)) = 0;
diff --git a/src/dynarec86/shim/shim_impl.c b/src/dynarec86/shim/shim_impl.c
index 9744845..dbe23fa 100644
--- a/src/dynarec86/shim/shim_impl.c
+++ b/src/dynarec86/shim/shim_impl.c
@@ -178,3 +178,6 @@ void dynarec86_setup_emu_helpers(x86emu_t* emu)
         emu->sbiidx[i] = &emu->regs[i];
     emu->sbiidx[4] = &emu->zero;
 }
+
+/* Only referenced by the WX86_DYNDUMP diagnostic path (native call names). */
+const char* GetNativeName(void* p) { (void)p; return "?"; }
