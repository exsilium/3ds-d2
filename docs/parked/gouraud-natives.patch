+// ---- interpolated light (issue #80) ------------------------------------------------
+//
+// A block whose four corner lights differ is drawn with a light per pixel:
+// a row of 32 light levels from the game's gradient table (0x7ca320, 32 x
+// 32 rows of 32: the row for the left and right edge's levels), each pixel
+// remapped through its level's shade table: d = shades[G[x] * 256 + s].
+// The edges' lights a and b are 4.4 fixed point (sar `shift` picks the
+// level), and step by da and db each row. The game's own routines do the
+// same with an unrolled loop per width; these match them byte for byte,
+// quirks included (the clipped ones read the gradient from the run's
+// start, not from its first drawn pixel). The walls' callers (4f8258,
+// 4f8276) return what the RLE ones leave in EAX, the gradient pointer, and
+// the game uses it: they return it too, as a guest address.
+constexpr uint32_t kGradient = 0x007ca320;
+
+inline const uint8_t *gradient(int32_t a, int32_t b, int32_t shift)
+{
+    return H(kGradient + ((uint32_t)(((a >> shift) << 5) + (b >> shift)) << 5));
+}
+
+inline void remap_lit(uint8_t *d, const uint8_t *s, const uint8_t *g, int32_t n)
+{
+    const uint8_t *shades = H(kShades);
+    for (int32_t i = 0; i < n; i++)
+        d[i] = shades[((uint32_t)g[i] << 8) + s[i]];
+}
+
+// 4f6bb0(ecx=src iso block, edx=dst, [8]=a, [c]=da, [10]=b, [14]=db), ret
+// 0x10. Only a row 4, 8, ... 32 wide is drawn (its jump table sends the others
+// past the row).
+void gouraud_iso(const uint8_t *src, uint8_t *dst, int32_t a, int32_t da, int32_t b, int32_t db, int32_t pitch)
+{
+    for (int r = 0; r < 15; r++, dst += pitch, a += da, b += db) {
+        const int32_t w = g_width[r];
+        if ((uint32_t)(w - 4) <= 0x1c && !(w & 3))
+            remap_lit(dst + g_xoff[r], src + g_soff[r], gradient(a, b, 7) + g_xoff[r], w);
+    }
+}
+
+// 4f71a0(ecx=src stream, edx=dst, [8]=a, [c]=da, [10]=b, [14]=db, [18]=rows,
+// [1c]=shift), ret 0x18: RleFlat's pairs, lit. A run of 0 or over 32 draws
+// nothing but still advances. Returns the gradient pointer (EAX).
+uint32_t gouraud_rle(const uint8_t *src, uint8_t *rowp, int32_t a, int32_t da, int32_t b, int32_t db, uint32_t rows,
+                 int32_t shift, int32_t pitch)
+{
+    const uint8_t *g = gradient(a, b, shift);
+    uint8_t *d = rowp;
+    while (rows != 0) {
+        const uint8_t skip = src[0], run = src[1];
+        src += 2;
+        if (skip == 0 && run == 0) {
+            a += da;
+            b += db;
+            rowp += pitch;
+            rows--;
+            g = gradient(a, b, shift);
+            d = rowp;
+            continue;
+        }
+        d += skip;
+        g += skip;
+        if (run >= 1 && run <= 32)
+            remap_lit(d, src, g, run);
+        d += run;
+        src += run;
+        g += run;
+    }
+    return (uint32_t)(g - g_base);
+}
+
+// 4f7850(ecx=x0, edx=y, [8]=src stream, [c]=dst, [10]=a, [14]=da, [18]=b,
+// [1c]=db, [20]=rows, [24]=shift), ret 0x20: clipped to the window.
+// Returns the gradient pointer (EAX), also where a row reaches the window's
+// bottom.
+uint32_t gouraud_rle_clipped(int32_t x0, int32_t y, const uint8_t *src, uint8_t *rowp, int32_t a, int32_t da, int32_t b,
+                         int32_t db, int32_t rows, int32_t shift, const FloorView &v)
+{
+    const uint8_t *g = gradient(a, b, shift);
+    uint8_t *d = rowp;
+    for (int32_t i = 0; i < rows;) {
+        const uint8_t skip = src[0], run = src[1];
+        src += 2;
+        if (skip == 0 && run == 0) {
+            b += db;
+            a += da;
+            rowp += v.pitch;
+            i++;
+            y++;
+            g = gradient(a, b, shift);
+            d = rowp;
+            continue;
+        }
+        if (y >= v.clip_b)
+            return (uint32_t)(g - g_base);
+        d += skip;
+        g += skip;
+        if (y >= v.clip_t) {
+            const int32_t x = x0 + (int32_t)(d - rowp);
+            const int32_t l = imax(0, v.clip_l - x);
+            const int32_t r = imin(imax(0, v.clip_r - x), (int32_t)run);
+            const int32_t n = r - l;
+            if (n >= 1 && n <= 32)
+                remap_lit(d + l, src + l, g, n);   // the gradient from the run's start (the original's)
+        }
+        d += run;
+        src += run;
+        g += run;
+    }
+    return (uint32_t)(g - g_base);
+}
+
+// 4f89f0's iso branch: a 15-row iso block, lit, clipped to the window, at
+// screen (x, y). a and b start at the top row's corners even when rows
+// above the window are skipped (the original's).
+void gouraud_iso_clipped(const uint8_t *src, int32_t x, int32_t y, uint8_t *dst, int32_t a, int32_t da, int32_t b,
+                         int32_t db, const FloorView &v)
+{
+    const int32_t r0 = imax(0, v.clip_t - y);
+    const int32_t r1 = imin(15, v.clip_b - y);
+    uint8_t *rowp = dst + (intptr_t)v.pitch * r0;
+    for (int32_t r = r0; r < r1; r++, rowp += v.pitch, a += da, b += db) {
+        const int32_t sx = x + g_xoff[r];
+        const int32_t l = imax(0, v.clip_l - sx);
+        const int32_t n = imin(imax(0, v.clip_r - sx), g_width[r]) - l;
+        if (n > 0)
+            remap_lit(rowp + g_xoff[r] + l, src + g_soff[r] + l, gradient(a, b, 7) + g_xoff[r], n);
+    }
+}
+
+uint32_t gouraud_iso_native(Cpu &c)
+{
+    gouraud_iso(H(c.reg(R_ECX)), H(c.reg(R_EDX)), (int32_t)c.arg(0), (int32_t)c.arg(1), (int32_t)c.arg(2),
+                (int32_t)c.arg(3), I32(kPitch));
+    return c.arg(3);   // the original leaves db in EAX
+}
+
+uint32_t gouraud_rle_native(Cpu &c)
+{
+    return gouraud_rle(H(c.reg(R_ECX)), H(c.reg(R_EDX)), (int32_t)c.arg(0), (int32_t)c.arg(1), (int32_t)c.arg(2),
+                       (int32_t)c.arg(3), c.arg(4), (int32_t)c.arg(5), I32(kPitch));
+}
+
+uint32_t gouraud_rle_clipped_native(Cpu &c)
+{
+    return gouraud_rle_clipped((int32_t)c.reg(R_ECX), (int32_t)c.reg(R_EDX), H(c.arg(0)), H(c.arg(1)),
+                               (int32_t)c.arg(2), (int32_t)c.arg(3), (int32_t)c.arg(4), (int32_t)c.arg(5),
+                               (int32_t)c.arg(6), (int32_t)c.arg(7), floor_view_now());
+}
