From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: 3ds-d2 <3ds-d2@localhost>
Date: Sat, 17 Oct 2026 10:16:15 +0300
Subject: [PATCH] 3DS mmap: map the guest arena with MEMOP_ALLOC at a 16
 MiB-aligned address above the heap

---
 src/dynarec86/shim/ctr/mman_ctr.c | 76 ++++++++++++++++++++++++++++++-
 1 file changed, 75 insertions(+), 1 deletion(-)

diff --git a/src/dynarec86/shim/ctr/mman_ctr.c b/src/dynarec86/shim/ctr/mman_ctr.c
index ed88fbb..a7700df 100644
--- a/src/dynarec86/shim/ctr/mman_ctr.c
+++ b/src/dynarec86/shim/ctr/mman_ctr.c
@@ -14,6 +14,7 @@
 #include <errno.h>
 #include <malloc.h>
 #include <stdint.h>
+#include <stdio.h>
 #include <stdlib.h>
 #include <string.h>
 #include "sys/mman.h"
@@ -56,6 +57,69 @@ static int make_executable(void* p, size_t len)
     return 0;
 }
 
+/* Arena blocks (MAP_NORESERVE): mapped with svcControlMemory(MEMOP_ALLOC)
+ * at 16 MiB-aligned addresses above libctru's heap, so the guest arena gets
+ * its exact membase alignment without the up-to-16 MiB of slack an aligned
+ * carve-out of the heap costs. Needs the app to leave that memory free (a
+ * fixed __ctru_heap_size). Falls back to the heap when it is not free. */
+extern u32 __ctru_heap, __ctru_heap_size;
+#define ARENA_ALIGN 0x1000000u
+#define ARENA_TOP   0x0F000000u   /* below the main thread's stack */
+static struct { u32 addr, size; } g_blocks[8];
+
+static void* arena_alloc(size_t len)
+{
+    u32 next = (__ctru_heap + __ctru_heap_size + ARENA_ALIGN - 1) & ~(ARENA_ALIGN - 1);
+    for (int i = 0; i < 8; i++)
+        if (g_blocks[i].size) {
+            u32 end = (g_blocks[i].addr + g_blocks[i].size + ARENA_ALIGN - 1) & ~(ARENA_ALIGN - 1);
+            if (end > next) next = end;
+        }
+    for (;;) {   /* skip 16 MiB slots something else already mapped */
+        MemInfo mi;
+        PageInfo pi;
+        if (next + len > ARENA_TOP)
+            return NULL;
+        if (R_SUCCEEDED(svcQueryMemory(&mi, &pi, next)) && mi.state == MEMSTATE_FREE && mi.base_addr + mi.size >= next + len)
+            break;
+        next += ARENA_ALIGN;
+    }
+    for (int i = 0; i < 8; i++)
+        if (!g_blocks[i].size) {
+            u32 out = 0;
+            Result rc = svcControlMemory(&out, next, 0, len, MEMOP_ALLOC, MEMPERM_READ | MEMPERM_WRITE);
+            if (R_FAILED(rc)) {
+                fprintf(stderr, "[mman] arena MEMOP_ALLOC %08lx+%08lx failed: %08lx (app free %lu KiB)\n",
+                        (unsigned long)next, (unsigned long)len, (unsigned long)rc,
+                        (unsigned long)(osGetMemRegionFree(MEMREGION_APPLICATION) >> 10));
+                return NULL;
+            }
+            MemInfo mi;   /* an unimplemented SVC can look like success: check */
+            PageInfo pi;
+            if (R_FAILED(svcQueryMemory(&mi, &pi, next)) || !(mi.perm & MEMPERM_WRITE))
+                return NULL;
+            g_blocks[i].addr = next;
+            g_blocks[i].size = len;
+            return (void*)next;
+        }
+    return NULL;
+}
+
+static int arena_free(void* p)
+{
+    for (int i = 0; i < 8; i++)
+        if (g_blocks[i].size && g_blocks[i].addr == (u32)p) {
+            u32 out = 0;
+            Result rc = svcControlMemory(&out, g_blocks[i].addr, 0, g_blocks[i].size, MEMOP_FREE, (MemPerm)0);
+            if (R_FAILED(rc))
+                fprintf(stderr, "[mman] arena MEMOP_FREE %08lx failed: %08lx\n", (unsigned long)g_blocks[i].addr,
+                        (unsigned long)rc);
+            g_blocks[i].size = 0;
+            return 1;
+        }
+    return 0;
+}
+
 void* mmap(void* addr, size_t length, int prot, int flags, int fd, off_t offset)
 {
     (void)fd; (void)offset;
@@ -69,7 +133,15 @@ void* mmap(void* addr, size_t length, int prot, int flags, int fd, off_t offset)
     // membase inside the block itself. Asking memalign for 16 MiB alignment
     // on top made it look for size + 16 MiB more, which a 72 MiB arena in a
     // 96 MiB heap cannot get.
-    void* p = memalign(PAGE, len);
+    void* p = NULL;
+    if ((flags & MAP_NORESERVE) && !(prot & PROT_EXEC)) {
+        p = arena_alloc(len);
+        if (p) {
+            memset(p, 0, len);
+            return p;
+        }
+    }
+    p = memalign(PAGE, len);
     if (!p) {
         errno = ENOMEM;
         return MAP_FAILED;
@@ -86,6 +158,8 @@ void* mmap(void* addr, size_t length, int prot, int flags, int fd, off_t offset)
 int munmap(void* addr, size_t length)
 {
     (void)length;
+    if (arena_free(addr))
+        return 0;
     // Executable chunks are never returned on hardware: their pages would go
     // back to the heap still RWX. (Box86 keeps code chunks for the process
     // lifetime; this only matters for the arena probe, which is RW.)
